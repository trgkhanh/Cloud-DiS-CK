{
  "name": "distributed-dms",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Distributed Document Management System",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "prisma:generate": "npm run generate --workspace=@dms/database",
    "start:search": "npm run start:dev --workspace=@dms/search-engine-service",
    "start:dept": "npm run start:dev --workspace=@dms/department-service"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^12.6.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/passport-jwt": "^4.0.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3"
  }
}
